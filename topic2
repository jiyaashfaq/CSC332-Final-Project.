#include <algorithm>
#include <fstream>
#include <iomanip>
#include <iostream>
#include <sstream>
#include <string>
#include <vector>

struct Process {
    int id;
    long long arrival;
    long long burst;
    long long start = 0;
    long long completion = 0;
};

int main(int argc, char* argv[]) {
    const char* filename = argc > 1 ? argv[1] : "input.txt";
    std::ifstream input(filename);

    if (!input) {
        std::cerr << "Could not open " << filename << '\n';
        return 1;
    }

    std::string line;
    int processCount;
    if (!std::getline(input, line)) {
        std::cerr << "Missing process count.\n";
        return 1;
    }

    std::istringstream header(line);
    std::string extra;
    if (!(header >> processCount) || processCount <= 0 || (header >> extra)) {
        std::cerr << "The first line must contain a positive process count.\n";
        return 1;
    }

    std::vector<Process> processes;

    for (int i = 0; i < processCount; ++i) {
        if (!std::getline(input, line)) {
            std::cerr << "Missing process data on line " << i + 2 << ".\n";
            return 1;
        }

        std::istringstream row(line);
        Process process{};
        if (!(row >> process.id >> process.arrival >> process.burst) ||
            process.arrival < 0 || process.burst <= 0) {
            std::cerr << "Invalid process data on line " << i + 2 << ".\n";
            return 1;
        }

        // Accept the optional fourth integer as well as the old three-column format.
        row >> std::ws;
        if (!row.eof()) {
            long long fourthValue;
            if (!(row >> fourthValue) || (row >> extra)) {
                std::cerr << "Invalid fourth column on line " << i + 2 << ".\n";
                return 1;
            }
        }

        processes.push_back(process);
    }

    // Keep file order when two processes arrive at the same time.
    std::stable_sort(processes.begin(), processes.end(),
        [](const Process& first, const Process& second) {
            return first.arrival < second.arrival;
        });

    constexpr long long switchTime = 2;
    long long clock = 0;
    long long totalWaiting = 0;
    long long totalService = 0;
    long long totalSwitching = 0;

    std::cout << "First-Come, First-Served (FCFS)\n\n"
              << std::left << std::setw(9) << "Process"
              << std::setw(9) << "Arrival"
              << std::setw(9) << "Service"
              << std::setw(9) << "Start"
              << std::setw(12) << "Completion"
              << std::setw(12) << "Turnaround"
              << "Waiting\n";

    for (std::size_t i = 0; i < processes.size(); ++i) {
        Process& process = processes[i];

        // Advance to the arrival time if the CPU has been idle.
        clock = std::max(clock, process.arrival);
        if (i > 0) {
            clock += switchTime;
            totalSwitching += switchTime;
        }

        process.start = clock;
        process.completion = process.start + process.burst;
        clock = process.completion;

        const long long turnaround = process.completion - process.arrival;
        const long long waiting = process.start - process.arrival;

        totalWaiting += waiting;
        totalService += process.burst;

        std::cout << std::setw(9) << process.id
                  << std::setw(9) << process.arrival
                  << std::setw(9) << process.burst
                  << std::setw(9) << process.start
                  << std::setw(12) << process.completion
                  << std::setw(12) << turnaround
                  << waiting << '\n';
    }

    const double averageWaiting =
        static_cast<double>(totalWaiting) / processes.size();
    const double efficiency =
        100.0 * totalService / (totalService + totalSwitching);

    std::cout << std::fixed << std::setprecision(2)
              << "\nTotal time: " << clock << " time units\n"
              << "Average waiting time: " << averageWaiting << " time units\n"
              << "CPU efficiency: " << efficiency << "%\n";

    return 0;
}
